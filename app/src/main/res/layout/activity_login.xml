<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo"
            android:contentDescription="@string/cd_app_logo" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:textColor="?attr/colorPrimary"
            android:fontFamily="sans-serif-black"
            android:textSize="26sp"
            android:text="@string/title_login" />

        <EditText
            android:id="@+id/etUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:ems="10"
            android:hint="@string/hint_enter_rfid"
            android:autofillHints="username"
            android:drawablePadding="10dp"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorHint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etUserPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:ems="10"
            android:hint="@string/hint_enter_pin"
            android:autofillHints="password"
            android:drawablePadding="10dp"
            android:padding="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorHint"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.CafeteriaCashier.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/action_login" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdmin"
            style="@style/Widget.CafeteriaCashier.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/action_admin_login" />

    </LinearLayout>
</ScrollView>
